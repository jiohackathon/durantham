PORT=3000
# Optional. By default data is stored in %TEMP%\Duramint\service-platform.sqlite
# DATABASE_FILE=./data/service-platform.sqlite
JWT_SECRET=replace-this-with-a-long-random-secret
# Set to true only on a hosted hackathon demo. It creates the first admin, technicians, and machines when the local database is empty.
AUTO_SEED_DEMO=false
DEMO_ADMIN_EMAIL=admin@duramint.local
# Set this only in the hosting provider's secret settings. Do not commit it.
DEMO_ADMIN_PASSWORD=choose-a-strong-demo-password
DEMO_ADMIN_NAME=Duramint Administrator
# Use the final public frontend URL when frontend and API are hosted separately.
CORS_ORIGIN=*
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Add future datasets without code changes: Table Name|issue_type,Other Table|other_issue
SUPABASE_TECHNICIAN_TABLES=Machine Breakdown|unexpected_breakdown,Overheating|overheating,Excessive Vibration|excessive_vibration
